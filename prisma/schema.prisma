generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A school using the system. Every school-owned record carries a schoolId
// so the app can host more than one school without a rewrite later.
model School {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  academicYears       AcademicYear[]
  classes             Class[]
  students            Student[]
  guardians           Guardian[]
  attendances         Attendance[]
  subjects            Subject[]
  teacherAssignments  TeacherAssignment[]
  examTypes           ExamType[]
  exams               Exam[]
  examSchedules       ExamSchedule[]
  examMarks           ExamMark[]
  gradingScales       GradingScale[]
  feeCategories       FeeCategory[]
  feeStructures       FeeStructure[]
  studentFees         StudentFee[]
  payments            Payment[]
  paymentAllocations  PaymentAllocation[]
  feeReceiptSequences FeeReceiptSequence[]

  @@map("schools")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  HR
  STUDENT
  GUARDIAN
}

// The single login identity for every person in the system. Later phases
// (Student, Teacher, Guardian, ...) will each link back to a User by id
// rather than duplicating name/contact/auth fields.
model User {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school                  School              @relation(fields: [schoolId], references: [id])
  attendancesMarked       Attendance[]        @relation("AttendanceMarkedBy")
  teacherAssignments      TeacherAssignment[] @relation("TeacherAssignments")
  examMarksEntered        ExamMark[]          @relation("ExamMarksEntered")
  examResultStatusChanges Exam[]              @relation("ExamResultStatusChangedBy")
  studentAccount          Student?            @relation("StudentAccount")
  guardianAccount         Guardian?           @relation("GuardianAccount")
  studentFeesAssigned     StudentFee[]        @relation("StudentFeeAssignedBy")
  studentFeesWaived       StudentFee[]        @relation("StudentFeeWaivedBy")
  studentFeesCancelled    StudentFee[]        @relation("StudentFeeCancelledBy")
  paymentsReceived        Payment[]           @relation("PaymentReceivedBy")
  paymentsVoided          Payment[]           @relation("PaymentVoidedBy")

  @@index([schoolId])
  @@map("users")
}

// A school year the student roster is organized by (e.g. "2026"). Kept to
// the minimum needed to assign a student to a class/section/roll; the full
// Academic Management module (creating/editing these) is a later phase.
model AcademicYear {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  isActive Boolean @default(true)

  school        School         @relation(fields: [schoolId], references: [id])
  students      Student[]
  attendances   Attendance[]
  exams         Exam[]
  feeStructures FeeStructure[]
  studentFees   StudentFee[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_years")
}

// Class 1-10. `order` is only for sorting in dropdowns/lists.
model Class {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  order    Int
  isActive Boolean @default(true)

  school             School              @relation(fields: [schoolId], references: [id])
  sections           Section[]
  students           Student[]
  attendances        Attendance[]
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  examSchedules      ExamSchedule[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("classes")
}

model Section {
  id       String  @id @default(cuid())
  classId  String
  name     String
  isActive Boolean @default(true)

  class              Class               @relation(fields: [classId], references: [id])
  students           Student[]
  attendances        Attendance[]
  teacherAssignments TeacherAssignment[]

  @@unique([classId, name])
  @@index([classId])
  @@map("sections")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

// No `userId` here yet: Phase 2 is school-office administration only, not a
// student portal. Add the login link when a later phase actually builds one,
// rather than carrying an unused column now.
model Student {
  id                     String        @id @default(cuid())
  schoolId               String
  studentUid             String        @unique
  admissionNumber        String
  name                   String
  nameBn                 String?
  photoUrl               String?
  dateOfBirth            DateTime
  gender                 Gender
  bloodGroup             BloodGroup?
  religion               String?
  nationality            String?       @default("Bangladeshi")
  birthCertificateNumber String?
  admissionDate          DateTime      @default(now())
  status                 StudentStatus @default(ACTIVE)
  academicYearId         String
  classId                String
  sectionId              String
  roll                   Int
  userId                 String?       @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  school       School            @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear      @relation(fields: [academicYearId], references: [id])
  class        Class             @relation(fields: [classId], references: [id])
  section      Section           @relation(fields: [sectionId], references: [id])
  user         User?             @relation("StudentAccount", fields: [userId], references: [id])
  guardians    StudentGuardian[]
  documents    StudentDocument[]
  attendances  Attendance[]
  examMarks    ExamMark[]
  studentFees  StudentFee[]
  payments     Payment[]

  @@unique([schoolId, admissionNumber])
  @@unique([sectionId, academicYearId, roll])
  @@index([schoolId])
  @@index([classId])
  @@index([sectionId])
  @@map("students")
}

// A guardian can be linked to more than one student (siblings), and is
// deduplicated by (schoolId, phone) when a new student is admitted so the
// same parent isn't recreated for every child.
model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  nameBn     String?
  phone      String
  email      String?
  occupation String?
  address    String?
  userId     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  user     User?             @relation("GuardianAccount", fields: [userId], references: [id])
  students StudentGuardian[]

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@map("guardians")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model StudentGuardian {
  id         String           @id @default(cuid())
  studentId  String
  guardianId String
  relation   GuardianRelation
  isPrimary  Boolean          @default(false)

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

enum DocumentType {
  BIRTH_CERTIFICATE
  STUDENT_PHOTO
  PREVIOUS_SCHOOL_CERTIFICATE
  OTHER
}

// fileUrl/fileName are nullable: no cloud storage provider is configured
// yet (see lib/storage), so a document can exist as a labeled record before
// an actual file is attached.
model StudentDocument {
  id         String       @id @default(cuid())
  studentId  String
  type       DocumentType
  title      String
  fileUrl    String?
  fileName   String?
  uploadedAt DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_documents")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

// classId/sectionId/academicYearId are stored on the record itself (not just
// looked up through Student) so a student's later promotion to a new
// class/section never rewrites history: this row always reflects where the
// student actually was on `date`.
model Attendance {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  classId        String
  sectionId      String
  academicYearId String
  date           DateTime         @db.Date
  status         AttendanceStatus
  markedById     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  markedBy     User         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([schoolId, studentId, date])
  @@index([schoolId, classId, sectionId, date])
  @@map("attendances")
}

// A subject is a reusable, school-wide entity (e.g. "Mathematics"); which
// classes it's taught in is the separate ClassSubject relationship below,
// so the subject record itself is never duplicated per class.
model Subject {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  nameBn   String?
  code     String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school             School              @relation(fields: [schoolId], references: [id])
  classSubjects      ClassSubject[]
  teacherAssignments TeacherAssignment[]
  examSchedules      ExamSchedule[]

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

// Which subjects are taught in which class. Independent of section and
// independent of who teaches it (that's TeacherAssignment).
model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("class_subjects")
}

// The smallest additive model needed to connect a teacher to what they
// teach: no separate Teacher/Employee table exists yet (that's full Teacher
// & Staff Management, a later phase), so this links directly to User (role
// TEACHER). A teacher can have any number of these rows — multiple classes,
// sections, and subjects.
model TeacherAssignment {
  id        String @id @default(cuid())
  schoolId  String
  teacherId String
  classId   String
  sectionId String
  subjectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  teacher User    @relation("TeacherAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, classId, sectionId, subjectId])
  @@index([schoolId])
  @@index([classId, sectionId])
  @@map("teacher_assignments")
}

// A school-defined category of examination (e.g. "Class Test", "Half-Yearly
// Exam", "Final Exam"). Not an enum: schools create and name their own
// exam types rather than being locked into a fixed list.
model ExamType {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  nameBn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  exams  Exam[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("exam_types")
}

enum ResultStatus {
  DRAFT
  FINALIZED
}

model Exam {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  examTypeId     String
  name           String
  nameBn         String?
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Phase 6: locks the whole exam's marks once results are approved. Tracks
  // only the most recent status change (who + when) - not a full audit log,
  // per the "minimum required state" instruction. Reopening clears back to
  // DRAFT and overwrites these with the reopen action's actor/time.
  resultStatus            ResultStatus @default(DRAFT)
  resultStatusChangedAt   DateTime?
  resultStatusChangedById String?

  // Phase 8: Snapshots the school's active grading scale and rules at the
  // exact moment of finalization. Subsequent modifications to the school's
  // active GradingScale will never alter published grades or report cards
  // for this finalized exam. Reopening clears this snapshot back to null.
  gradingScaleName     String?
  gradingRulesSnapshot Json?

  school                School         @relation(fields: [schoolId], references: [id])
  academicYear          AcademicYear   @relation(fields: [academicYearId], references: [id])
  examType              ExamType       @relation(fields: [examTypeId], references: [id])
  schedules             ExamSchedule[]
  resultStatusChangedBy User?          @relation("ExamResultStatusChangedBy", fields: [resultStatusChangedById], references: [id])

  @@index([schoolId])
  @@index([academicYearId])
  @@index([examTypeId])
  @@map("exams")
}

// A school-defined set of grade boundaries (e.g. "Standard School Grading").
// A school can have several; at most one is meant to be active for actual
// result calculation at a time, but multiple can exist (draft/inactive) for
// simple editing without disrupting already-calculated results elsewhere.
model GradingScale {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  nameBn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School      @relation(fields: [schoolId], references: [id])
  gradeRules GradeRule[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("grading_scales")
}

// One percentage band within a GradingScale (e.g. 70.00-79.99 -> "A", 4.00).
// minPercentage/maxPercentage are Decimal (exact, base-10 storage), not
// Float, specifically so boundary comparisons never suffer IEEE-754 binary
// rounding surprises (e.g. 0.1 + 0.2 !== 0.3) - both ends are inclusive, so
// adjacent bands must be entered as e.g. 70.00-79.99 and 80.00-100.00 to
// avoid overlapping or leaving gaps.
model GradeRule {
  id             String  @id @default(cuid())
  gradingScaleId String
  minPercentage  Decimal @db.Decimal(5, 2)
  maxPercentage  Decimal @db.Decimal(5, 2)
  grade          String
  gradeBn        String?
  gradePoint     Decimal @db.Decimal(3, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@index([gradingScaleId])
  @@map("grade_rules")
}

// A single subject scheduled for a class within an exam. Sections are not
// part of this model on purpose: every section of a class sits the same
// exam on the same date for the same subject, so scheduling is class-level.
// Which section's marks are being entered is chosen at marks-entry time,
// not here.
model ExamSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  examId    String
  classId   String
  subjectId String
  examDate  DateTime @db.Date
  startTime String?
  endTime   String?
  room      String?
  fullMarks Int
  passMarks Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School     @relation(fields: [schoolId], references: [id])
  exam    Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  class   Class      @relation(fields: [classId], references: [id])
  subject Subject    @relation(fields: [subjectId], references: [id])
  marks   ExamMark[]

  @@unique([examId, classId, subjectId])
  @@index([schoolId])
  @@index([classId])
  @@map("exam_schedules")
}

// A student's result for one exam schedule. No classId/sectionId/academicYearId
// denormalization here (unlike Attendance) — marks are never read after a
// student's later promotion in a way that requires point-in-time class/section,
// and Phase 5 explicitly excludes promotion/report-card logic that would need it.
model ExamMark {
  id             String   @id @default(cuid())
  schoolId       String
  examScheduleId String
  studentId      String
  marks          Int?
  isAbsent       Boolean  @default(false)
  enteredById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  examSchedule ExamSchedule @relation(fields: [examScheduleId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy    User         @relation("ExamMarksEntered", fields: [enteredById], references: [id])

  @@unique([examScheduleId, studentId])
  @@index([schoolId])
  @@index([studentId])
  @@map("exam_marks")
}

// --- Phase 8: Fees & Accounts ---
//
// Chain: FeeCategory (named bucket, e.g. "Tuition Fee") -> FeeStructure
// (what a class normally owes for that category in a given academic year)
// -> StudentFee (the actual charge assigned to one student, with its own
// permanently-copied amount) -> Payment + PaymentAllocation (money received,
// split across one or more StudentFee rows, possibly over several payments).
//
// Historical-amount rule: StudentFee.amount is copied from FeeStructure at
// assignment time and is never re-read from FeeStructure again. Raising next
// year's tuition on a FeeStructure must never change an already-assigned
// StudentFee's amount - unlike Exam's gradingRulesSnapshot (a whole rule
// table, needed to re-evaluate grade boundaries), a fee charge is a single
// flat number, so storing it directly on StudentFee *is* the entire
// snapshot; no JSON needed.

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

// A cached, transactionally-maintained projection of a StudentFee's payment
// state (see calculateFeeBalance in src/lib/fees/calculate-fee-balance.ts).
// Every write path that can affect it recomputes it fresh from live,
// non-voided PaymentAllocation rows and overwrites this column in the same
// transaction - it is never accepted as client input and never drives a
// payment/waiver/cancellation decision on its own.
enum StudentFeeStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_BANKING
  OTHER
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

// A school-defined bucket of charges (Tuition Fee, Admission Fee, Exam Fee,
// Transport Fee, ...). No amount here - amount lives on FeeStructure and is
// copied again onto StudentFee, so renaming/deactivating a category never
// touches historical charges. Deactivate rather than delete once in use.
model FeeCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  nameBn      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  feeStructures FeeStructure[]
  studentFees   StudentFee[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_categories")
}

// A priced fee template for one class in one academic year (e.g. "Class 6
// Tuition Fee, 2026, 1200.00/month"). Config, not a charge to any student -
// see StudentFee for the per-student, historical charge this feeds.
model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String
  feeCategoryId  String
  name           String
  nameBn         String?
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency @default(ONE_TIME)
  dueDate        DateTime?    @db.Date
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  class        Class        @relation(fields: [classId], references: [id])
  feeCategory  FeeCategory  @relation(fields: [feeCategoryId], references: [id])
  studentFees  StudentFee[]

  @@unique([schoolId, academicYearId, classId, feeCategoryId, name])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
  @@index([feeCategoryId])
  @@map("fee_structures")
}

// A student's actual charge. `amount`/`feeCategoryId`/`name` are copied from
// FeeStructure at assignment time (or set directly for an ad-hoc charge with
// no template - feeStructureId is nullable for exactly that case), so this
// row stays fully self-contained even if the FeeStructure/FeeCategory it
// came from is later edited or deactivated. Waiving/cancelling preserve the
// original amount and record who/why/when, mirroring Payment's void fields;
// both are mutually exclusive in practice with having any non-voided
// payment allocation, enforced by the waive/cancel actions.
model StudentFee {
  id             String           @id @default(cuid())
  schoolId       String
  studentId      String
  academicYearId String
  feeStructureId String?
  feeCategoryId  String
  name           String
  amount         Decimal          @db.Decimal(10, 2)
  dueDate        DateTime?        @db.Date
  status         StudentFeeStatus @default(UNPAID)
  assignedById   String

  waivedAt     DateTime?
  waivedById   String?
  waiverReason String?

  cancelledAt   DateTime?
  cancelledById String?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School              @relation(fields: [schoolId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  feeStructure FeeStructure?       @relation(fields: [feeStructureId], references: [id])
  feeCategory  FeeCategory         @relation(fields: [feeCategoryId], references: [id])
  assignedBy   User                @relation("StudentFeeAssignedBy", fields: [assignedById], references: [id])
  waivedBy     User?               @relation("StudentFeeWaivedBy", fields: [waivedById], references: [id])
  cancelledBy  User?               @relation("StudentFeeCancelledBy", fields: [cancelledById], references: [id])
  allocations  PaymentAllocation[]

  @@unique([studentId, feeStructureId])
  @@index([schoolId])
  @@index([studentId])
  @@index([feeStructureId])
  @@index([status])
  @@map("student_fees")
}

// A single money receipt. Never edited or deleted once COMPLETED - only
// ever transitions COMPLETED -> VOIDED (voidedAt/voidedById/voidReason set,
// amount/receiptNumber untouched). `amount` is the total tendered;
// PaymentAllocation records how it was split across one or more StudentFee
// rows, always for exactly this student and this school (enforced in the
// createPayment action, not the schema, since Prisma can't cross-check two
// unrelated foreign keys declaratively).
model Payment {
  id            String        @id @default(cuid())
  schoolId      String
  studentId     String
  receiptNumber String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  status        PaymentStatus @default(COMPLETED)
  notes         String?
  receivedById  String
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school      School              @relation(fields: [schoolId], references: [id])
  student     Student             @relation(fields: [studentId], references: [id])
  receivedBy  User                @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  voidedBy    User?               @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  allocations PaymentAllocation[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@map("payments")
}

// How much of a Payment went to a particular StudentFee. A Payment can cover
// several fees at once; a StudentFee can be paid across several Payments
// over time (partial payments). Rows are permanent - even a voided
// Payment's allocations stay as history; balance calculation simply
// excludes allocations whose Payment.status is VOIDED.
model PaymentAllocation {
  id           String   @id @default(cuid())
  schoolId     String
  paymentId    String
  studentFeeId String
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id])
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentFee StudentFee @relation(fields: [studentFeeId], references: [id])

  @@index([schoolId])
  @@index([paymentId])
  @@index([studentFeeId])
  @@map("payment_allocations")
}

// The receipt-number counter, one row per (school, calendar year of
// Payment.paidAt). Purely an atomically-incremented counter - the
// composite (schoolId, year) IS its identity, never joined to or read for
// anything but generating the next receipt number inside a payment's own
// transaction. See createPayment in src/actions/fees/payments.ts: the
// `UPDATE ... SET lastNumber = lastNumber + 1` this compiles to takes a
// row lock, which is what makes concurrent receipt-number generation safe
// without raw SQL or a distributed lock.
model FeeReceiptSequence {
  schoolId   String
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, year])
  @@map("fee_receipt_sequences")
}
